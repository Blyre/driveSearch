DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token
PRICE_THRESHOLD_EUR=70.0
SCRAPE_INTERVAL_HOURS=6
DIGEST_INTERVAL_HOURS=24
# eBay Browse API — register a free app at https://developer.ebay.com
# Go to: My Account > Application Access Keys > View/Generate API keys (Production tab)
# App ID → EBAY_CLIENT_ID, Cert ID → EBAY_CLIENT_SECRET
# EBAY_CLIENT_ID=YourApp-YourApp-PRD-xxxxxxxxxxxx-xxxxxxxx
# EBAY_CLIENT_SECRET=PRD-xxxxxxxxxxxxxxxxxxxx
# eBay Marketplace Account Deletion notification endpoint (required for production compliance)
# Pick any secret string for EBAY_VERIFICATION_TOKEN and paste it in the eBay portal
# EBAY_VERIFICATION_TOKEN=your-secret-token
# EBAY_NOTIFICATION_ENDPOINT_URL=https://your-public-domain.example.com/ebay/notifications
# EBAY_NOTIFICATION_PORT=8080
# Optional: path to system chromium to skip playwright's own download
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
